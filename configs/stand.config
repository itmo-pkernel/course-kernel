# Ядро стенда курса «Программирование в режиме ядра»: обычный вариант.
# Накладывается поверх x86_64_defconfig (см. build.sh). Каждая строка вида
# CONFIG_X=y|n|"..." после сборки конфигурации проверяется скриптом: если
# Kconfig её молча отбросил, сборка останавливается.
CONFIG_LOCALVERSION="-kmc"
# CONFIG_LOCALVERSION_AUTO is not set

# Модули: загрузка и выгрузка, без подписи и версий символов
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set

# То, на что опирается конвейер: initramfs, devtmpfs, консоль на COM1
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Наблюдаемость (лекция 7)
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# Сторожевые механизмы: зависание в лабе должно давать диагностику, а не тишину
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
# CONFIG_PANIC_ON_OOPS is not set

# Лишнее для ВМ без устройств: выключено ради времени сборки
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_HID is not set
# CONFIG_AGP is not set
