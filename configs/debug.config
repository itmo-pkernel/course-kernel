# Отладочный вариант ядра стенда: всё из stand.config плюс диагностика.
# Используется в лабах 3, 4, 7, 8 (KASAN/UBSAN/lockdep — см. course_plan.md, раздел 5).
CONFIG_LOCALVERSION="-kmc-debug"

# Отладочная информация: faddr2line по .ko в лабе 7 (модули собираются с -g)
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_REDUCED=y

CONFIG_DEBUG_KERNEL=y

# Память (лекции 3, 7)
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
# CONFIG_KFENCE is not set
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF=y

# Неопределённое поведение (лекция 7)
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_SHIFT=y
CONFIG_UBSAN_SANITIZE_ALL=y

# Синхронизация (лекция 4)
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
